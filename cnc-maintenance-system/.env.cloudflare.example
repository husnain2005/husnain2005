# =============================================================================
# CNC Maintenance System - Configurazione Ambiente
# =============================================================================
# Copia questo file come .env e modifica i valori
# cp .env.cloudflare.example .env
# =============================================================================

# ─── Database PostgreSQL ─────────────────────────────────────────────────────
DB_NAME=cnc_maintenance
DB_USER=postgres
DB_PASSWORD=CambiaMiConUnaPasswordSicura123!

# ─── Sicurezza JWT ───────────────────────────────────────────────────────────
# IMPORTANTE: Genera una chiave segreta lunga e casuale!
# Puoi usare: openssl rand -base64 64
JWT_SECRET=CAMBIA-QUESTA-CHIAVE-CON-UNA-STRINGA-MOLTO-LUNGA-E-CASUALE-abc123xyz789

# ─── Cloudflare Tunnel ───────────────────────────────────────────────────────
# Ottieni il token da: https://one.dash.cloudflare.com/
# Networks > Tunnels > Crea Tunnel > Copia il token
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoixxxxxx...il-tuo-token-qui

# ─── URL Pubblico ────────────────────────────────────────────────────────────
# Il dominio che configuri su Cloudflare
PUBLIC_URL=https://cnc.tuodominio.com

# ─── Opzionali ───────────────────────────────────────────────────────────────
# Porta locale per il database (se vuoi accedere da pgAdmin)
DB_PORT=5433

# Dimensione massima upload (50MB default)
MAX_FILE_SIZE=52428800
