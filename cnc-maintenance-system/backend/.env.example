# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cnc_maintenance
DB_USER=postgres
DB_PASSWORD=postgres_password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Server Configuration
PORT=3001
NODE_ENV=development

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# OpenAI API Key (for PDF extraction)
OPENAI_API_KEY=your-openai-api-key

# ──────────────────────────────────────────────
# EMAIL / SMTP — scegli uno dei due provider
# ──────────────────────────────────────────────

# Provider attivo: "gmail" oppure "outlook"
SMTP_PROVIDER=gmail

# ── GMAIL ──
# 1. Attiva la verifica in 2 passaggi sul tuo account Google
# 2. Vai su https://myaccount.google.com/apppasswords
# 3. Crea una "App password" (categoria: Posta)
# 4. Incolla la password di 16 caratteri in SMTP_PASS
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tuamail@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM=Gestionale GIANA <tuamail@gmail.com>

# ── OUTLOOK / Microsoft 365 ──
# Usa le credenziali del tuo account Microsoft.
# Se l'account ha MFA abilitato, crea una App Password:
# https://account.microsoft.com/security → Opzioni di sicurezza avanzate
#
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tuamail@outlook.com
# SMTP_PASS=la-tua-password
# SMTP_FROM=Gestionale GIANA <tuamail@outlook.com>

# URL pubblico dell'app (usato per il link "Apri nel gestionale" nell'email)
# APP_URL=http://localhost:3005
