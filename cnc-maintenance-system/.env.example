# =============================================================================
# CNC Maintenance System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before running docker-compose.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------

# Name of the database to create
POSTGRES_DB=cnc_maintenance

# Database superuser name
POSTGRES_USER=postgres

# Database superuser password (REQUIRED - change this!)
POSTGRES_PASSWORD=change_me_to_a_strong_password

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------

# Secret key used to sign JWT tokens (REQUIRED - use a long random string)
# Generate one with: openssl rand -base64 64
JWT_SECRET=change_me_to_a_random_secret

# How long JWT tokens remain valid (e.g., 1h, 24h, 7d)
JWT_EXPIRES_IN=24h

# Maximum file upload size in bytes (default: 10 MB)
MAX_FILE_SIZE=10485760
